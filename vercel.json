{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "moviesaura.vercel.app"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://moviesaura.site/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.moviesaura.site"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://moviesaura.site/$1"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "server/server.js"
    },
    {
      "src": "/sitemap.xml",
      "dest": "server/server.js"
    },
    {
      "src": "/sitemap.xsl",
      "dest": "server/server.js"
    },
    {
      "src": "/robots.txt",
      "dest": "client/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "client/$1"
    }
  ]
}
